# Copy to `.env` before running `docker compose up`:
#
#   cp .env.example .env

# PostgreSQL — used by the `postgres` service and the backend `DATABASE_URL`.
POSTGRES_USER=skl
POSTGRES_PASSWORD=skl
POSTGRES_DB=skl
POSTGRES_PORT=5432

# Frontend -> backend base URL. This is read by the browser, so it must be an
# address reachable from the host. It is also inlined into the frontend build.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Link to the interactive API reference shown in the app footer. Defaults to
# `${NEXT_PUBLIC_API_URL}/docs` when empty.
NEXT_PUBLIC_API_DOCS_URL=

# Backend upload cap in MiB for POST /api/v1/datasets (NFR-030). Defaults to 10.
skl_MAX_UPLOAD_MB=10

# Root log level of the backend logger: DEBUG, INFO, WARNING, or ERROR.
skl_LOG_LEVEL=INFO

# Comma-separated allow-list of browser origins permitted to call the API.
# Entries are scheme + host (+ optional port) with no trailing slash.
skl_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Whether CORS responses may carry `Access-Control-Allow-Credentials`.
# Must be false when skl_CORS_ORIGINS contains `*`.
skl_CORS_ALLOW_CREDENTIALS=true

# Whether /docs, /redoc, and /openapi.json are served.
skl_ENABLE_INTERACTIVE_DOCS=true

# Worker limits: concurrent jobs, per-attempt timeout, total attempts, the
# exponential-backoff base, and the age after which a job left behind by a
# crashed process is marked failed.
skl_MAX_CONCURRENT_JOBS=1
skl_JOB_TIMEOUT_SECONDS=1800
skl_JOB_MAX_ATTEMPTS=2
skl_JOB_RETRY_BASE_SECONDS=2
skl_WORKER_STALE_SECONDS=3600
